generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "internal"]
}

model AppUser {
  id                    String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("id")
  fullName              String                    @map("nombre_completo") @db.VarChar(160)
  email                 String                    @db.VarChar(255) @map("correo_electronico")
  passwordHash          String                    @map("hash_clave")
  role                  String                    @default("operator") @db.VarChar(20) @map("rol")
  isActive              Boolean                   @default(true) @map("activo")
  mustChangePassword    Boolean                   @default(false) @map("debe_cambiar_clave")
  failedLoginAttempts   Int                       @default(0) @map("intentos_acceso_fallidos") @db.SmallInt
  lockedUntil           DateTime?                 @map("bloqueado_hasta") @db.Timestamptz(6)
  lastLoginAt           DateTime?                 @map("ultimo_acceso") @db.Timestamptz(6)
  createdAt             DateTime                  @default(now()) @map("creado_en") @db.Timestamptz(6)
  updatedAt             DateTime                  @default(now()) @map("actualizado_en") @db.Timestamptz(6)
  passwordResetTokens   PasswordResetToken[]
  authSessions          AuthSession[]
  clientsCreated        Client[]                  @relation("ClientCreatedBy")
  ownedProjects         Project[]                 @relation("ProjectOwner")
  projectMemberships    ProjectMembership[]
  membershipsAssigned   ProjectMembership[]       @relation("MembershipAssignedBy")
  simulationsCreated    Simulation[]              @relation("SimulationCreatedBy")
  simulationsReviewed   Simulation[]              @relation("SimulationReviewedBy")
  estimatesCreated      ProjectPriceEstimate[]    @relation("EstimateCreatedBy")
  equipmentCostsRecorded InternalEquipmentCost[]  @relation("EquipmentCostRecordedBy")
  internalAnalysesCreated InternalFinancialAnalysis[] @relation("InternalAnalysisCreatedBy")
  appSettingsUpdated    AppSetting[]              @relation("SettingUpdatedBy")
  auditEvents           AuditEvent[]              @relation("AuditActor")

  @@map("tb_usuarios")
  @@schema("public")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("id")
  userId    String    @map("usuario_id") @db.Uuid
  tokenHash String    @unique(map: "uq_tb_recuperacion_claves_hash_token") @map("hash_token")
  expiresAt DateTime  @map("expira_en") @db.Timestamptz(6)
  usedAt    DateTime? @map("usado_en") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)
  user      AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_tb_recuperacion_claves_usuario")

  @@index([userId], map: "idx_tb_recuperacion_claves_usuario")
  @@map("tb_recuperacion_claves")
  @@schema("public")
}

model AuthSession {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("id")
  userId    String    @map("usuario_id") @db.Uuid
  tokenHash String    @unique(map: "uq_tb_sesiones_hash_token") @map("hash_token") @db.Char(64)
  expiresAt DateTime  @map("expira_en") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)
  lastSeenAt DateTime @default(now()) @map("ultimo_uso_en") @db.Timestamptz(6)
  user      AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_tb_sesiones_usuario")

  @@index([userId, expiresAt], map: "idx_tb_sesiones_usuario_expira")
  @@map("tb_sesiones")
  @@schema("public")
}

model Client {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("id")
  legalName    String    @map("nombre_legal") @db.VarChar(200)
  legalType    String?   @map("tipo_persona") @db.VarChar(20)
  clientType   String    @default("business") @map("tipo_cliente") @db.VarChar(30)
  taxIdType    String?   @map("tipo_identificacion") @db.VarChar(20)
  taxId        String?   @map("identificacion_fiscal") @db.VarChar(40)
  address      String?   @map("direccion")
  contactName  String?   @map("nombre_contacto") @db.VarChar(160)
  contactEmail String?   @map("correo_contacto") @db.VarChar(255)
  contactPhone String?   @map("telefono_contacto") @db.VarChar(40)
  notes        String?   @map("notas")
  createdBy    String?   @map("creado_por") @db.Uuid
  createdAt    DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @map("actualizado_en") @db.Timestamptz(6)
  creator      AppUser?  @relation("ClientCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull, map: "fk_tb_clientes_creado_por")
  projects     Project[]

  @@map("tb_clientes")
  @@schema("public")
}

model Project {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("id")
  clientId          String              @map("cliente_id") @db.Uuid
  name              String              @db.VarChar(200) @map("nombre")
  referenceCode     String?             @unique(map: "uq_tb_proyectos_codigo_referencia") @map("codigo_referencia") @db.VarChar(60)
  city              String?             @db.VarChar(120) @map("ciudad")
  department        String?             @db.VarChar(120) @map("departamento")
  country           String              @default("Colombia") @db.VarChar(80) @map("pais")
  address           String?             @map("direccion")
  latitude          Decimal?            @db.Decimal(9, 6) @map("latitud")
  longitude         Decimal?            @db.Decimal(9, 6) @map("longitud")
  gridAvailable     Boolean?            @map("red_disponible")
  systemType        String?             @map("modalidad") @db.VarChar(20)
  status            String              @default("draft") @db.VarChar(25) @map("estado")
  ownerId           String?             @map("responsable_id") @db.Uuid
  notes             String?             @map("notas")
  createdAt         DateTime            @default(now()) @map("creado_en") @db.Timestamptz(6)
  updatedAt         DateTime            @default(now()) @map("actualizado_en") @db.Timestamptz(6)
  client            Client              @relation(fields: [clientId], references: [id], onDelete: Restrict, map: "fk_tb_proyectos_cliente")
  owner             AppUser?            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull, map: "fk_tb_proyectos_responsable")
  memberships       ProjectMembership[]
  energyConsumption EnergyConsumption[]
  solarResourceInputs SolarResourceInput[]
  projectLoads      ProjectLoad[]
  simulations       Simulation[]

  @@index([clientId], map: "idx_tb_proyectos_cliente")
  @@index([ownerId], map: "idx_tb_proyectos_responsable")
  @@map("tb_proyectos")
  @@schema("public")
}

model ProjectMembership {
  projectId  String   @map("proyecto_id") @db.Uuid
  userId     String   @map("usuario_id") @db.Uuid
  accessRole String   @map("rol_acceso") @db.VarChar(20)
  assignedBy String?  @map("asignado_por") @db.Uuid
  createdAt  DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade, map: "fk_tb_pertenencias_proyecto_proyecto")
  user       AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_tb_pertenencias_proyecto_usuario")
  assigner   AppUser? @relation("MembershipAssignedBy", fields: [assignedBy], references: [id], onDelete: SetNull, map: "fk_tb_pertenencias_proyecto_asignado_por")

  @@id([projectId, userId], map: "pk_tb_pertenencias_proyecto")
  @@index([userId, accessRole], map: "idx_tb_pertenencias_proyecto_usuario_rol")
  @@map("tb_pertenencias_proyecto")
  @@schema("public")
}

model EnergyConsumption {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("id")
  projectId        String   @map("proyecto_id") @db.Uuid
  periodMonth      DateTime @map("periodo_mes") @db.Date
  energyKwh        Decimal  @map("energia_kwh") @db.Decimal(14, 3)
  totalBillCop     Decimal? @map("valor_factura_cop") @db.Decimal(16, 2)
  energyRateCopKwh Decimal? @map("tarifa_cop_kwh") @db.Decimal(14, 4)
  peakDemandKw     Decimal? @map("demanda_maxima_kw") @db.Decimal(14, 3)
  loadProfile      Json?    @map("perfil_carga") @db.JsonB
  source           String   @default("manual") @db.VarChar(25) @map("fuente")
  createdAt        DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade, map: "fk_tb_consumos_energia_proyecto")

  @@unique([projectId, periodMonth], map: "uq_tb_consumos_energia_proyecto_periodo")
  @@index([projectId], map: "idx_tb_consumos_energia_proyecto")
  @@map("tb_consumos_energia")
  @@schema("public")
}

model EquipmentCatalog {
  id                  String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("id")
  category            String                  @db.VarChar(20) @map("categoria")
  manufacturer        String                  @db.VarChar(120) @map("fabricante")
  model               String                  @map("modelo") @db.VarChar(160)
  nominalPowerKw      Decimal?                @map("potencia_nominal_kw") @db.Decimal(13, 6)
  capacityKwh         Decimal?                @map("capacidad_kwh") @db.Decimal(13, 3)
  usableDodFraction   Decimal?                @map("fraccion_descarga_util") @db.Decimal(5, 4)
  efficiencyFraction  Decimal?                @map("fraccion_eficiencia") @db.Decimal(5, 4)
  areaM2              Decimal?                @map("area_m2") @db.Decimal(10, 3)
  specs               Json                    @default("{}") @db.JsonB @map("especificaciones")
  isActive            Boolean                 @default(true) @map("activo")
  isDemo              Boolean                 @default(false) @map("es_demostracion")
  createdAt           DateTime                @default(now()) @map("creado_en") @db.Timestamptz(6)
  updatedAt           DateTime                @default(now()) @map("actualizado_en") @db.Timestamptz(6)
  equipmentCosts      InternalEquipmentCost[]
  simulationsAsPanel  Simulation[]            @relation("SimulationPanel")
  simulationsAsInverter Simulation[]          @relation("SimulationInverter")
  simulationsAsBattery Simulation[]           @relation("SimulationBattery")

  @@unique([category, manufacturer, model], map: "uq_tb_catalogo_equipos_categoria_fabricante_modelo")
  @@index([category, isActive], map: "idx_tb_catalogo_equipos_categoria_activo")
  @@map("tb_catalogo_equipos")
  @@schema("public")
}

model SolarResourceInput {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("id")
  projectId           String       @map("proyecto_id") @db.Uuid
  source              String       @db.VarChar(40) @map("fuente")
  sourceReference     String?      @map("referencia_fuente")
  periodStart         DateTime?    @map("periodo_inicio") @db.Date
  periodEnd           DateTime?    @map("periodo_fin") @db.Date
  retrievedAt         DateTime?    @map("consultado_en") @db.Timestamptz(6)
  peakSunHoursDay     Decimal?     @map("horas_sol_pico_dia") @db.Decimal(6, 3)
  irradianceKwhM2Year Decimal?     @map("irradiacion_kwh_m2_anio") @db.Decimal(10, 3)
  tiltDegrees         Decimal?     @map("inclinacion_grados") @db.Decimal(5, 2)
  azimuthDegrees      Decimal?     @map("azimut_grados") @db.Decimal(6, 2)
  assumptions         Json         @default("{}") @db.JsonB @map("supuestos")
  createdAt           DateTime     @default(now()) @map("creado_en") @db.Timestamptz(6)
  project             Project      @relation(fields: [projectId], references: [id], onDelete: Cascade, map: "fk_tb_recursos_solares_proyecto")
  simulations         Simulation[]

  @@map("tb_recursos_solares")
  @@schema("public")
}

model ProjectLoad {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("id")
  projectId            String   @map("proyecto_id") @db.Uuid
  name                 String   @db.VarChar(160) @map("nombre")
  ratedPowerKw         Decimal  @map("potencia_nominal_kw") @db.Decimal(14, 6)
  quantity             Int      @default(1) @map("cantidad")
  hoursPerDay          Decimal  @map("horas_por_dia") @db.Decimal(6, 2)
  criticalForBackup    Boolean  @default(false) @map("critica_para_respaldo")
  simultaneityFraction Decimal  @default(1) @map("fraccion_simultaneidad") @db.Decimal(5, 4)
  notes                String?  @map("notas")
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade, map: "fk_tb_cargas_proyecto_proyecto")

  @@map("tb_cargas_proyecto")
  @@schema("public")
}

model Simulation {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("id")
  projectId                String   @map("proyecto_id") @db.Uuid
  createdBy                String?  @map("creado_por") @db.Uuid
  version                  Int      @map("version")
  title                    String?  @db.VarChar(160) @map("titulo")
  systemType               String   @map("modalidad") @db.VarChar(20)
  batteryEnabled           Boolean  @map("bateria_habilitada")
  panelId                  String?  @map("equipo_panel_id") @db.Uuid
  inverterId               String?  @map("equipo_inversor_id") @db.Uuid
  batteryId                String?  @map("equipo_bateria_id") @db.Uuid
  solarResourceId          String?  @map("recurso_solar_id") @db.Uuid
  desiredCoverageFraction  Decimal? @map("fraccion_cobertura_objetivo") @db.Decimal(5, 4)
  systemLossFraction       Decimal? @map("fraccion_perdidas_sistema") @db.Decimal(5, 4)
  roofUsableAreaM2         Decimal? @map("area_util_techo_m2") @db.Decimal(12, 3)
  backupHours              Decimal? @map("horas_respaldo") @db.Decimal(9, 2)
  backupLoadKw             Decimal? @map("carga_respaldo_kw") @db.Decimal(14, 6)
  designInputs             Json     @default("{}") @map("entradas_diseno") @db.JsonB
  calculationMethodVersion String   @map("version_metodologia_calculo") @db.VarChar(40)
  resultPanelCount         Int?     @map("resultado_cantidad_paneles")
  resultPvKwp              Decimal? @map("resultado_potencia_fv_kwp") @db.Decimal(14, 4)
  resultGenerationKwhMonth Decimal? @map("resultado_generacion_kwh_mes") @db.Decimal(14, 3)
  resultGenerationKwhYear  Decimal? @map("resultado_generacion_kwh_anio") @db.Decimal(14, 3)
  resultBatteryNominalKwh  Decimal? @map("resultado_bateria_nominal_kwh") @db.Decimal(14, 3)
  resultBatteryUsableKwh   Decimal? @map("resultado_bateria_util_kwh") @db.Decimal(14, 3)
  resultBackupHours        Decimal? @map("resultado_horas_respaldo") @db.Decimal(12, 3)
  resultDetails            Json     @default("{}") @map("detalle_resultados") @db.JsonB
  warnings                 Json     @default("[]") @db.JsonB @map("advertencias")
  status                   String   @default("draft") @db.VarChar(24) @map("estado")
  reviewedBy               String?  @map("revisado_por") @db.Uuid
  reviewedAt               DateTime? @map("revisado_en") @db.Timestamptz(6)
  reviewNotes              String?  @map("notas_revision")
  createdAt                DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  project                  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade, map: "fk_tb_simulaciones_proyecto")
  creator                  AppUser? @relation("SimulationCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull, map: "fk_tb_simulaciones_creado_por")
  reviewer                 AppUser? @relation("SimulationReviewedBy", fields: [reviewedBy], references: [id], onDelete: SetNull, map: "fk_tb_simulaciones_revisado_por")
  panel                    EquipmentCatalog? @relation("SimulationPanel", fields: [panelId], references: [id], onDelete: SetNull, map: "fk_tb_simulaciones_equipo_panel")
  inverter                 EquipmentCatalog? @relation("SimulationInverter", fields: [inverterId], references: [id], onDelete: SetNull, map: "fk_tb_simulaciones_equipo_inversor")
  battery                  EquipmentCatalog? @relation("SimulationBattery", fields: [batteryId], references: [id], onDelete: SetNull, map: "fk_tb_simulaciones_equipo_bateria")
  solarResource            SolarResourceInput? @relation(fields: [solarResourceId], references: [id], onDelete: SetNull, map: "fk_tb_simulaciones_recurso_solar")
  priceEstimates           ProjectPriceEstimate[]
  internalAnalyses         InternalFinancialAnalysis[]
  legacyAnalysesV1         LegacyFinancialAnalysisV1[]

  @@unique([projectId, version], map: "uq_tb_simulaciones_proyecto_version")
  @@index([projectId, createdAt(sort: Desc)], map: "idx_tb_simulaciones_proyecto_creado")
  @@index([status], map: "idx_tb_simulaciones_estado")
  @@map("tb_simulaciones")
  @@schema("public")
}

model ProjectPriceEstimate {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("id")
  simulationId      String     @map("simulacion_id") @db.Uuid
  version           Int        @default(1) @map("version")
  currency          String     @default("COP") @db.Char(3) @map("moneda")
  estimatedTotalCop Decimal    @map("total_estimado_cop") @db.Decimal(18, 2)
  includesVat       Boolean    @default(false) @map("incluye_iva")
  estimatedVatCop   Decimal?   @map("iva_estimado_cop") @db.Decimal(18, 2)
  estimateStatus    String     @default("draft") @map("estado_estimacion") @db.VarChar(20)
  priceMethodVersion String    @map("version_metodologia_precio") @db.VarChar(40)
  validUntil        DateTime?  @map("vigente_hasta") @db.Date
  publicNotes       String?    @map("notas_comerciales")
  createdBy         String?    @map("creado_por") @db.Uuid
  createdAt         DateTime   @default(now()) @map("creado_en") @db.Timestamptz(6)
  simulation        Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade, map: "fk_tb_precios_estimados_simulacion")
  creator           AppUser?   @relation("EstimateCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull, map: "fk_tb_precios_estimados_creado_por")
  internalAnalyses  InternalFinancialAnalysis[]

  @@unique([simulationId, version], map: "uq_tb_precios_estimados_simulacion_version")
  @@index([simulationId, createdAt(sort: Desc)], map: "idx_tb_precios_estimados_simulacion_creado")
  @@map("tb_precios_estimados")
  @@schema("public")
}

model InternalEquipmentCost {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("id")
  equipmentId        String           @map("equipo_id") @db.Uuid
  unitPurchaseCostCop Decimal         @map("costo_adquisicion_unitario_cop") @db.Decimal(18, 2)
  supplierName       String?           @map("proveedor") @db.VarChar(160)
  effectiveFrom      DateTime          @default(dbgenerated("CURRENT_DATE")) @map("vigente_desde") @db.Date
  effectiveTo        DateTime?         @map("vigente_hasta") @db.Date
  recordedBy         String?           @map("registrado_por") @db.Uuid
  createdAt          DateTime          @default(now()) @map("creado_en") @db.Timestamptz(6)
  equipment          EquipmentCatalog  @relation(fields: [equipmentId], references: [id], onDelete: Cascade, map: "fk_tb_costos_equipos_equipo")
  recorder           AppUser?          @relation("EquipmentCostRecordedBy", fields: [recordedBy], references: [id], onDelete: SetNull, map: "fk_tb_costos_equipos_registrado_por")

  @@index([equipmentId, effectiveFrom(sort: Desc)], map: "idx_tb_costos_equipos_equipo_vigencia")
  @@map("tb_costos_equipos")
  @@schema("internal")
}

model InternalFinancialAnalysis {
  id                       String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("id")
  simulationId             String               @map("simulacion_id") @db.Uuid
  priceEstimateId          String?              @map("precio_estimado_id") @db.Uuid
  currency                 String               @default("COP") @db.Char(3) @map("moneda")
  equipmentCostCop         Decimal              @default(0) @map("costo_equipos_cop") @db.Decimal(18, 2)
  laborCostCop             Decimal              @default(0) @map("costo_mano_obra_cop") @db.Decimal(18, 2)
  logisticsCostCop         Decimal              @default(0) @map("costo_logistica_cop") @db.Decimal(18, 2)
  otherDirectCostCop       Decimal              @default(0) @map("otros_costos_directos_cop") @db.Decimal(18, 2)
  contingencyCostCop       Decimal              @default(0) @map("costo_contingencia_cop") @db.Decimal(18, 2)
  totalInternalCostCop     Decimal              @map("costo_interno_total_cop") @db.Decimal(18, 2)
  estimatedSaleValueCop    Decimal              @map("valor_venta_estimado_cop") @db.Decimal(18, 2)
  // The SQL migration defines these as GENERATED ALWAYS expressions; Prisma cannot express the expression itself.
  estimatedGrossProfitCop  Decimal?             @default(dbgenerated()) @map("utilidad_bruta_estimada_cop") @db.Decimal(18, 2)
  estimatedGrossMarginPct  Decimal?             @default(dbgenerated()) @map("margen_bruto_estimado_pct") @db.Decimal(9, 4)
  estimatedAnnualSavingsCop Decimal?             @map("ahorro_anual_estimado_cop") @db.Decimal(18, 2)
  annualOpexCop            Decimal?             @map("opex_anual_cop") @db.Decimal(18, 2)
  simplePaybackYears       Decimal?             @map("periodo_retorno_simple_anios") @db.Decimal(10, 3)
  confidentialAssumptions Json                 @default("{}") @map("supuestos_confidenciales") @db.JsonB
  createdBy                String?              @map("creado_por") @db.Uuid
  createdAt                DateTime             @default(now()) @map("creado_en") @db.Timestamptz(6)
  simulation               Simulation           @relation(fields: [simulationId], references: [id], onDelete: Cascade, map: "fk_tb_analisis_financieros_simulacion")
  priceEstimate            ProjectPriceEstimate? @relation(fields: [priceEstimateId], references: [id], onDelete: SetNull, map: "fk_tb_analisis_financieros_precio_estimado")
  creator                  AppUser?             @relation("InternalAnalysisCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull, map: "fk_tb_analisis_financieros_creado_por")

  @@index([simulationId, createdAt(sort: Desc)], map: "idx_tb_analisis_financieros_simulacion_creado")
  @@map("tb_analisis_financieros")
  @@schema("internal")
}

model LegacyFinancialAnalysisV1 {
  id                       String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("id")
  simulationId             String     @map("simulacion_id") @db.Uuid
  currency                 String     @default("COP") @db.Char(3) @map("moneda")
  capexCop                 Decimal?   @map("inversion_inicial_cop") @db.Decimal(18, 2)
  estimatedAnnualSavingsCop Decimal?  @map("ahorro_anual_estimado_cop") @db.Decimal(18, 2)
  annualOpexCop            Decimal?   @map("opex_anual_cop") @db.Decimal(18, 2)
  simplePaybackYears       Decimal?   @map("periodo_retorno_simple_anios") @db.Decimal(10, 3)
  assumptions              Json       @default("{}") @db.JsonB @map("supuestos")
  createdAt                DateTime   @default(now()) @map("creado_en") @db.Timestamptz(6)
  simulation               Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade, map: "fk_tb_analisis_financieros_legacy_simulacion")

  @@map("tb_analisis_financieros_legacy_v1")
  @@schema("internal")
}

model AppSetting {
  settingKey   String   @id @map("clave_configuracion") @db.VarChar(120)
  settingValue Json     @map("valor_configuracion") @db.JsonB
  description  String?  @map("descripcion")
  updatedBy    String?  @map("actualizado_por") @db.Uuid
  updatedAt    DateTime @default(now()) @map("actualizado_en") @db.Timestamptz(6)
  updater      AppUser? @relation("SettingUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull, map: "fk_tb_configuracion_actualizado_por")

  @@map("tb_configuracion")
  @@schema("public")
}

model AuditEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("id")
  actorId    String?  @map("usuario_id") @db.Uuid
  action     String   @db.VarChar(100) @map("accion")
  entityType String?  @map("tipo_entidad") @db.VarChar(80)
  entityId   String?  @map("entidad_id") @db.Uuid
  metadata   Json     @default("{}") @db.JsonB @map("metadatos")
  createdAt  DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actor      AppUser? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull, map: "fk_tb_auditoria_usuario")

  @@index([createdAt(sort: Desc)], map: "idx_tb_auditoria_creado")
  @@index([actorId], map: "idx_tb_auditoria_usuario")
  @@map("tb_auditoria")
  @@schema("public")
}
