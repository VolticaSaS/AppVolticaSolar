# Railway: vincula la variable DATABASE_URL del servicio PostgreSQL al servicio web.
# Para desarrollo local, copia este archivo a .env.local y añade una URL local.
DATABASE_URL=

# Solo para el bootstrap manual del primer administrador. Nunca guardar en Git.
# El script crea el usuario únicamente si aún no existe ningún administrador.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
