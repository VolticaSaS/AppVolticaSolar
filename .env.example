# PostgreSQL debe conectarse a la base db_voltica_solar.
# En Railway, referencia DATABASE_URL del servicio de base de datos; nunca guardes credenciales aquí.
# Para desarrollo local, copia este archivo a .env.local y añade una URL local.
DATABASE_URL=

# Solo para el bootstrap manual del primer administrador. Nunca guardar en Git.
# El script crea el usuario únicamente si aún no existe ningún administrador.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
